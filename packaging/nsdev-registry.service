[Unit]
Description=NSdev Registry — OCI Distribution v2 + HTTP/3 + ssh-bridged handshake
Documentation=https://github.com/dmitry-mikushin/nsdev-registry
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nsdev-registry
Group=nsdev-registry

# Generated by /etc/nsdev-registry/init-cert.sh on first start when the
# /etc/nsdev-registry/tls.{crt,key} pair is missing — keeps fresh
# installs working out of the box without forcing operators to know
# certbot / openssl up front. Replace at any time with real PKI; the
# unit doesn't care about the cert origin.
ExecStartPre=/usr/libexec/nsdev-registry/init-cert.sh

ExecStart=/usr/bin/nsdev-registry serve /etc/nsdev-registry/config.yml

Restart=on-failure
RestartSec=2

# State directory: storage for the OCI blob filesystem driver. systemd
# creates it with 0750 ownership the first time the unit starts so the
# package install doesn't have to.
StateDirectory=nsdev-registry
StateDirectoryMode=0750

# Lock down the process — registry binary handles network I/O and a
# storage directory; that's all it should touch.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true

# AmbientCapabilities is empty: nsdev-registry binds 5000/tcp+udp
# which doesn't need CAP_NET_BIND_SERVICE. If an operator changes to
# a privileged port, drop a systemd override file with
# `AmbientCapabilities=CAP_NET_BIND_SERVICE` and matching
# CapabilityBoundingSet — don't edit this unit.
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
